			local function spawnParticle(torso)
				if activeParticles >= maxParticles then return end
				activeParticles += 1
	
				local targetChar = torso.Parent
				local rootPart = targetChar:FindFirstChild("HumanoidRootPart") or torso
				local spawnCF = rootPart.CFrame + Vector3.new(0, -100, 0)
	
				local part = endpoint:InvokeServer("CreatePart", "Normal", spawnCF, workspace)
				if not part then
					activeParticles -= 1
					return
				end
	
