				ohno({"SetName", {{Part = part, Name = "mlg_particle"}}})
				ohno({"SyncResize", {{Part = part, CFrame = spawnCF, Size = sizehax}}})
				ohno({"SyncAnchor", {{Part = part, Anchored = true}}})
				ohno({"SyncCollision", {{Part = part, CanCollide = false}}})
