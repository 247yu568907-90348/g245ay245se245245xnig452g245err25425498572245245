				ohno({"SyncMesh", {{Part = part, Scale = sizehax}}})
				ohno({"SyncMesh", {{Part = part, VertexColor = Vector3.new(2, 2, 2)}}})
	
				local attachCF = torso.CFrame
				ohno({"SyncMove", {{Part = part, CFrame = attachCF}}})
	
				local randomDir = Vector3.new(
					math.random(-speed, speed),
					math.random(-speed * 0.5, speed * 0.9),
					math.random(-speed, speed)
				)
				local startPos = attachCF.Position
	
				task.defer(function()
					local t = 0
					while t < lifetime do
						if not part or not part.Parent then break end
	
						local progress = t / lifetime
						local smooth = progress * progress * (3 - 2 * progress)
						local newPos = startPos + (randomDir * smooth)
	
						ohno({"SyncMove", {{Part = part, CFrame = CFrame.new(newPos)}}})
	
						task.wait()
						t += 0.03
					end
	
					if part and part.Parent then
						ohno({"Remove", {part}})
					end
					activeParticles -= 1
				end)
			end
	
